# 로컬 실행용. .env로 복사해서 채운다. (.env는 커밋하지 않는다)
# GitHub Actions에서는 같은 이름으로 저장소 Secrets에 넣는다.

# HY-ON 주소와 개인 액세스 토큰 (계정 → 설정 → 새 액세스 토큰)
# 주소는 로그인 후 브라우저 주소창의 도메인으로 바꾼다 (Canvas API가 /api/v1 아래에 있는 곳)
HYON_BASE_URL=https://learning.hanyang.ac.kr
HYON_TOKEN=

# 노션 내부 통합 토큰과 과제DB ID (과제DB 페이지에서 '연결'에 통합을 추가해야 접근 가능)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 카카오 디벨로퍼스 REST API 키, 클라이언트 시크릿, 내 계정 리프레시 토큰 (talk_message 동의)
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=

# 구글 캘린더 'iCal 형식의 비공개 주소'. 제목에 EXAM_KEYWORD(쉼표로 여러 개) 중 하나가 들어간 일정만 시험으로 본다.
GCAL_ICS_URL=
EXAM_KEYWORD=시험,고사

# 노션 과제DB를 비출 구글 캘린더 전용 캘린더 ID와 서비스 계정 키 파일 (비어 있으면 미러를 건너뜀)
# 스크립트는 자기가 만든 일정만 고치고 지운다 (직접 넣은 일정은 그대로 둔다).
GCAL_TARGET_CALENDAR_ID=
GCAL_SERVICE_ACCOUNT_FILE=gcal-service-account.json

# 공개일이 없을 때 마감 며칠 전을 시작일로 둘지
START_OFFSET_DAYS=7

# Canvas 강의명 → 노션 '과목' 이름 (JSON, 선택)
COURSE_ALIASES={}
